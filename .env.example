# Copy this file to .env and fill in the values. Never commit .env.

# Password for the web pages (username: growth)
UI_PASSWORD=

# Shared secret for signing webhook events (any long random string)
WEBHOOK_SECRET=

# Anthropic API key for the assistant (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: where the database file lives (default: cdp.db)
# DATABASE_PATH=cdp.db

# Optional: which model the assistant uses (default: claude-haiku-5-5)
# ASSISTANT_MODEL=claude-haiku-5-5